---
import { getCollection } from 'astro:content';
import FormattedDate from '../FormattedDate.astro';
import { sortBlogPostsForArchive } from '../../utils/content-dates';

interface Props {
  enabled?: boolean;
  count?: number;
}

const { enabled = true, count = 2 } = Astro.props;

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const projectsHref = `${basePath}/projects/`;

const entries = await getCollection('projects', ({ data }) => !data.draft);
const featured = enabled
  ? sortBlogPostsForArchive(entries.filter((entry) => entry.id !== 'index')).slice(
      0,
      Math.max(1, count),
    )
  : [];
---

{
  featured.length > 0 && (
    <section class="featured-projects" aria-label="精选项目">
      <h2 class="featured-heading">精选项目</h2>
      <ul class="featured-list">
        {featured.map((project) => (
          <li class="featured-item">
            <a class="featured-link" href={`${projectsHref}${project.id}/`}>
              <span class="featured-title">{project.data.title}</span>
              <span class="featured-meta">
                <FormattedDate date={project.data.date} />
                {project.data.tags.slice(0, 3).map((tag) => (
                  <small>{tag}</small>
                ))}
              </span>
              <span class="featured-desc">{project.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .featured-projects {
    display: grid;
    gap: 12px;
    padding: 4px 0 12px;
  }
  .featured-heading {
    margin: 0;
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--paper-ink-faint);
  }
  .featured-list {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .featured-link {
    display: grid;
    gap: 6px;
    padding: 14px 16px;
    border: 1px solid var(--paper-line);
    border-radius: 8px;
    background: var(--paper-surface);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 180ms ease,
      background 180ms ease,
      transform 180ms ease;
  }
  .featured-link:hover {
    border-color: var(--paper-line-strong);
    background: var(--paper-control-hover);
    transform: translateY(-1px);
  }
  .featured-title {
    font-family: var(--font-ui-label);
    font-size: 1.05rem;
    font-weight: 600;
  }
  .featured-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    color: var(--paper-ink-faint);
    font-family: var(--font-ui-label);
    font-size: 0.74rem;
  }
  .featured-meta small {
    padding: 2px 8px;
    border: 1px solid var(--paper-line);
    border-radius: 999px;
  }
  .featured-desc {
    color: var(--paper-ink-soft);
    font-size: 0.9rem;
    line-height: 1.7;
  }
</style>
